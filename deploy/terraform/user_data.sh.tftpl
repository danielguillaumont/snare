#!/bin/bash
# Snare instance bootstrap (Amazon Linux 2023, arm64), rendered by Terraform templatefile().
# Template values use dollar-brace; shell variables are brace-free or escaped with a double dollar.
set -euo pipefail
exec > >(tee /var/log/snare-bootstrap.log) 2>&1

dnf -y install docker
systemctl enable --now docker

# ---- data volume (attached after boot by aws_volume_attachment; wait for it)
serial=$(echo "${data_volume_id}" | tr -d -)
dev=/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$serial
for _ in $(seq 1 60); do [ -e "$dev" ] && break; sleep 5; done
[ -e "$dev" ] || { echo "data volume never appeared"; exit 1; }
if ! blkid "$dev" >/dev/null 2>&1; then
  mkfs.xfs -L snare-data "$dev"
fi
mkdir -p /srv/snare
grep -q 'LABEL=snare-data' /etc/fstab || echo 'LABEL=snare-data /srv/snare xfs defaults,nofail,noatime 0 2' >> /etc/fstab
mount -a
mkdir -p /srv/snare/db /srv/snare/caddy
chown 65532:65532 /srv/snare/db
chmod 700 /srv/snare/db

# ---- configuration. Secrets come from SSM at boot and are never in Terraform state.
install -d -m 700 /etc/snare
umask 077
aws ssm get-parameters-by-path --region "${region}" --path "${ssm_prefix}" --with-decryption \
  --query 'Parameters[*].[Name,Value]' --output text |
  while IFS=$'\t' read -r name value; do
    echo "$${name##*/}=$value"
  done > /etc/snare/secrets.env
for k in SNARE_KEY SNARE_ADMIN_KEY SNARE_SEAL_KEY; do
  grep -q "^$k=" /etc/snare/secrets.env || { echo "missing $k under ${ssm_prefix} (run scripts/put-secrets.sh)"; exit 1; }
done

token=$(curl -sS -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 60')
private_ip=$(curl -sS -H "X-aws-ec2-metadata-token: $token" http://169.254.169.254/latest/meta-data/local-ipv4)

cat > /etc/snare/snare.env <<ENV
SNARE_ZONE=${zone}.
SNARE_ANSWER_IP=${answer_ip}
SNARE_PUBLIC_URL=https://${callback_host}
SNARE_TRUST_PROXY=1
ENV
cat > /etc/snare/caddy.env <<ENV
ACME_EMAIL=${acme_email}
CALLBACK_HOST=${callback_host}
API_HOST=${api_host}
APP_HOST=${app_host}
ENV
cat > /etc/snare/Caddyfile <<'CADDY'
${caddyfile}
CADDY

# ---- services: plain systemd units around docker run (no compose binary to fetch)
docker network inspect snare >/dev/null 2>&1 || docker network create snare

cat > /etc/systemd/system/snare.service <<UNIT
[Unit]
Description=Snare server
After=docker.service
Requires=docker.service

[Service]
Restart=always
ExecStartPre=-/usr/bin/docker rm -f snare
ExecStartPre=/usr/bin/docker pull ${image}
ExecStart=/usr/bin/docker run --rm --name snare --network snare \
  --env-file /etc/snare/secrets.env --env-file /etc/snare/snare.env \
  -v /srv/snare/db:/data \
  -p $private_ip:53:5353/udp -p $private_ip:53:5353/tcp \
  --read-only --tmpfs /tmp:rw,noexec,nosuid,size=64m --cap-drop ALL --security-opt no-new-privileges:true \
  --log-driver awslogs --log-opt awslogs-region=${region} \
  --log-opt awslogs-group=${log_group} --log-opt awslogs-stream=snare \
  ${image}
ExecStop=/usr/bin/docker stop -t 15 snare

[Install]
WantedBy=multi-user.target
UNIT

cat > /etc/systemd/system/snare-caddy.service <<UNIT
[Unit]
Description=Caddy TLS front for Snare
After=snare.service
Requires=docker.service

[Service]
Restart=always
ExecStartPre=-/usr/bin/docker rm -f caddy
ExecStart=/usr/bin/docker run --rm --name caddy --network snare \
  --env-file /etc/snare/caddy.env \
  -v /etc/snare/Caddyfile:/etc/caddy/Caddyfile:ro -v /srv/snare/caddy:/data \
  -p 80:80 -p 443:443 \
  --cap-drop ALL --cap-add NET_BIND_SERVICE --security-opt no-new-privileges:true \
  --log-driver awslogs --log-opt awslogs-region=${region} \
  --log-opt awslogs-group=${log_group} --log-opt awslogs-stream=caddy \
  caddy:2.10-alpine
ExecStop=/usr/bin/docker stop -t 15 caddy

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now snare.service snare-caddy.service
echo "snare bootstrap done"
